rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{articleId} {
      allow read, write: if true;
    }
    match /corpus_docs/{docId} {
      allow read, write: if true;
    }
    match /gallery/{galleryId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /genres/{genreId} {
      allow read, write: if true;
    }
    match /team_members/{memberId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

